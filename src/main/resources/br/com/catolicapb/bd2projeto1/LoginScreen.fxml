<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="457.0" prefWidth="600.0" styleClass="anchor-pane" stylesheets="@../../../../css/LoginStyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.catolicapb.bd2projeto1.controller.LoginScreenController">
   <children>
      <Button layoutX="264.0" layoutY="367.0" mnemonicParsing="false" onAction="#btEnterAction" prefHeight="25.0" prefWidth="80.0" styleClass="login-button" text="Entrar" />
      <TextField layoutX="211.0" layoutY="246.0" />
      <PasswordField layoutX="211.0" layoutY="300.0" />

      <!-- Substituindo os ícones antigos -->
      <FontIcon iconLiteral="fas-lock" iconSize="16" layoutX="366.0" layoutY="319.0" />
      <FontIcon iconLiteral="fas-user" iconSize="16" layoutX="366.0" layoutY="264.0" />

      <Label layoutX="211.0" layoutY="229.0" text="Usuário" />
      <Label layoutX="211.0" layoutY="283.0" text="Senha" />

      <Button disable="true" layoutX="360.0" layoutY="246.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="29.0" styleClass="button-icon">
         <graphic>
            <FontIcon iconLiteral="fas-user" iconSize="16" />
         </graphic>
      </Button>
      <Button layoutX="360.0" layoutY="300.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="28.0" styleClass="button-icon">
         <graphic>
            <FontIcon iconLiteral="fas-lock" iconSize="16" />
         </graphic>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>

      <Pane layoutY="-1.0" prefHeight="120.0" prefWidth="600.0" styleClass="pane-header">
         <children>
            <Label alignment="CENTER" layoutX="148.0" layoutY="14.0" prefWidth="305.0" text="LibraTech">
               <font>
                  <Font name="System Bold" size="64.0" />
               </font>
            </Label>
         </children>
      </Pane>
      <Label alignment="CENTER" layoutX="263.0" layoutY="176.0" text="Iniciar sessão">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
